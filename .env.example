# demo：无需密钥的词面检索 + 原文摘录；api：Embedding API + 大模型生成
RAG_MODE=demo

# 两类 API 可来自不同服务商。Base URL 填接口前缀，不填 /chat/completions 或 /embeddings。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# 也支持 OPENAI_API_KEY / OPENAI_BASE_URL 作为上面两类配置的公共后备。
# 部分兼容服务每次最多接受少量输入，可把 batch size 调低至 1。
EMBEDDING_BATCH_SIZE=16
API_TIMEOUT=60
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=4
MIN_SIMILARITY=0.12
MAX_CONTEXT_CHARS=10000
